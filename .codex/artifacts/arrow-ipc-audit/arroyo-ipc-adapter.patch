@@ -98,0 +99,20 @@ impl SourceOperator for SingleFileSourceFunc {
+        // DAL-417 benchmark-only IPC source. No row serializer is called.
+        if self.input_file.ends_with(".arrow") {
+            let path = self.input_file.clone();
+            let batches = tokio::task::spawn_blocking(move || {
+                let file = std::fs::File::open(path).unwrap();
+                arrow::ipc::reader::StreamReader::try_new(file, None)
+                    .unwrap().collect::<Result<Vec<_>, _>>().unwrap()
+            }).await.unwrap();
+            let batches: Vec<_> = batches.into_iter().map(|batch| {
+                let columns = ctx.out_schema.schema.fields().iter().map(|field| {
+                    let name = if field.name() == "_timestamp" { "ts" } else { field.name() };
+                    let index = batch.schema().index_of(name).unwrap();
+                    arrow::compute::cast(batch.column(index), field.data_type()).unwrap()
+                }).collect();
+                arrow::record_batch::RecordBatch::try_new(ctx.out_schema.schema.clone(), columns).unwrap()
+            }).collect();
+            crate::DAL417_IPC_START.set(std::time::Instant::now()).unwrap();
+            for batch in batches { collector.collect(batch).await; }
+            return SourceFinishType::Final;
+        }
