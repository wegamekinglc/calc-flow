+                    let file = std::fs::File::create(&temporary).unwrap();
+                    let mut writer = arrow::ipc::writer::StreamWriter::try_new(file, &batches[0].schema()).unwrap();
+                    for batch in &batches { writer.write(batch).unwrap(); }
+                    writer.finish().unwrap();
+                    drop(writer);
+                    std::fs::rename(temporary, path).unwrap();
+                    started.elapsed().as_secs_f64()
+                }).await.unwrap();
+                let input = std::env::var("DAL417_INPUT_PATH").unwrap();
+                let metadata = serde_json::json!({
+                    "core_seconds": core_seconds, "output_binding_seconds": output_binding_seconds,
+                    "output_ipc_seconds": output_ipc_seconds, "output_rows": self.ipc_rows,
+                    "output_schema": schema, "input": crate::DAL417_INPUT_METRICS.get().unwrap(),
+                    "source_eof_before_output": std::path::Path::new(&format!("{input}.eof")).exists(),
+                    "clock_contract": "ready-native-Batch-v2"
+                });
+                tokio::fs::write(format!("{}.meta.json", self.output_path), serde_json::to_vec(&metadata).unwrap()).await.unwrap();
+                self.ipc_emitted = true;
+            }
+            return;
+        }
