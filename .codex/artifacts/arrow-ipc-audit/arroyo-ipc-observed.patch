diff --git a/crates/arroyo-connectors/src/single_file/source.rs b/crates/arroyo-connectors/src/single_file/source.rs
index d5f79f8..cb01564 100644
--- a/crates/arroyo-connectors/src/single_file/source.rs
+++ b/crates/arroyo-connectors/src/single_file/source.rs
@@ -98,0 +99,46 @@ impl SourceOperator for SingleFileSourceFunc {
+        // DAL-417 benchmark-only Arrow IPC input. No row JSON codec is called.
+        if self.input_file.ends_with(".arrow") {
+            let origin = std::time::Instant::now();
+            let origin_utc = SystemTime::now().duration_since(SystemTime::UNIX_EPOCH).unwrap().as_nanos() as u64;
+            let path = self.input_file.clone();
+            let batches = tokio::task::spawn_blocking(move || {
+                let file = std::fs::File::open(path).unwrap();
+                arrow::ipc::reader::StreamReader::try_new(file, None).unwrap()
+                    .collect::<Result<Vec<_>, _>>().unwrap()
+            }).await.unwrap();
+            let input_ipc_seconds = origin.elapsed().as_secs_f64();
+            let binding_start = std::time::Instant::now();
+            let batches: Vec<_> = batches.into_iter().map(|batch| {
+                let columns = ctx.out_schema.schema.fields().iter().map(|field| {
+                    let name = if field.name() == "_timestamp" { "ts" } else { field.name() };
+                    let index = batch.schema().index_of(name).unwrap();
+                    arrow::compute::cast(batch.column(index), field.data_type()).unwrap()
+                }).collect();
+                arrow::record_batch::RecordBatch::try_new(ctx.out_schema.schema.clone(), columns).unwrap()
+            }).collect();
+            let metadata = serde_json::json!({
+                "source_entered_utc_ns": origin_utc,
+                "input_ipc_seconds": input_ipc_seconds,
+                "input_binding_seconds": binding_start.elapsed().as_secs_f64(),
+                "input_rows": batches.iter().map(|b| b.num_rows()).sum::<usize>(),
+                "input_batches": batches.len(), "clock_contract": "ready-native-Batch-v2"
+            });
+            crate::DAL417_INPUT_METRICS.set(metadata.clone()).unwrap();
+            tokio::fs::write(format!("{}.ready.json", self.input_file), serde_json::to_vec(&metadata).unwrap()).await.unwrap();
+            if std::env::var_os("DAL417_GATED").is_some() {
+                while !std::path::Path::new(&format!("{}.start", self.input_file)).exists() {
+                    tokio::time::sleep(std::time::Duration::from_millis(1)).await;
+                }
+            }
+            crate::DAL417_IPC_START.set(std::time::Instant::now()).unwrap();
+            for batch in batches { collector.collect(batch).await; }
+            tokio::fs::write(format!("{}.fed", self.input_file), b"all batches submitted").await.unwrap();
+            if std::env::var_os("DAL417_GATED").is_some() {
+                while !std::path::Path::new(&format!("{}.finish", self.input_file)).exists() {
+                    if let Some(value) = self.handle_control(ctx.control_rx.try_recv().ok(), ctx, collector).await { return value; }
+                    tokio::time::sleep(std::time::Duration::from_millis(1)).await;
+                }
+            }
+            tokio::fs::write(format!("{}.eof", self.input_file), b"source Final follows").await.unwrap();
+            return SourceFinishType::Final;
+        }
