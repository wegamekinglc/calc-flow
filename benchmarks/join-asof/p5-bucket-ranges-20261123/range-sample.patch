+fn range_sample() {
+    let runtime = tokio::runtime::Runtime::new().unwrap();
+    let batches = ScenarioBatches::new();
+    run_probe(&runtime, &batches);
+    runtime.block_on(async {
+        let job = job();
+        let mut operator = new_operator();
+        let mut collector = EdgeCollector::new(operator.output_ports().to_vec());
+        feed(&mut operator, &job, &mut collector, "left", &batches.left_fan).await;
+        let start = Instant::now();
+        operator.process_data(
+            "right", (*batches.right_fan).clone(), &plain_ctx(&job), &mut collector,
+        ).await.unwrap();
+        let elapsed = start.elapsed();
+        check_pairs(&mut collector, &batches.left_fan, &batches.right_fan, 10);
+        assert_eq!(operator.status().emitted_match_rows, 100_000);
+        let (rss, hwm) = read_rss();
+        println!("RANGE_SAMPLE {},{},{}", elapsed.as_nanos(), rss, hwm);
+    });
