{
  "$defs": {
    "AggregateFunction": {
      "description": "Aggregate function supported by the first built-in window operator.",
      "oneOf": [
        {
          "const": "count",
          "description": "Count non-null input values.",
          "type": "string"
        },
        {
          "const": "sum",
          "description": "Sum numeric input values.",
          "type": "string"
        },
        {
          "const": "min",
          "description": "Select the minimum supported scalar.",
          "type": "string"
        },
        {
          "const": "max",
          "description": "Select the maximum supported scalar.",
          "type": "string"
        },
        {
          "const": "avg",
          "description": "Compute the arithmetic mean of numeric input values.",
          "type": "string"
        }
      ]
    },
    "AggregateSpec": {
      "additionalProperties": false,
      "description": "One declared window aggregate and its output column name.",
      "properties": {
        "column": {
          "description": "Input column name.",
          "type": "string"
        },
        "function": {
          "$ref": "#/$defs/AggregateFunction",
          "description": "Aggregate function."
        },
        "output": {
          "description": "Output column name.",
          "type": "string"
        }
      },
      "required": [
        "function",
        "column",
        "output"
      ],
      "type": "object"
    },
    "ArrowFieldSpec": {
      "additionalProperties": false,
      "properties": {
        "data_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nullable": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "data_type"
      ],
      "type": "object"
    },
    "BatchKind": {
      "enum": [
        "table",
        "array"
      ],
      "type": "string"
    },
    "ConnectorRef": {
      "additionalProperties": false,
      "description": "Exact identity of a connector implementation.",
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "name",
        "version"
      ],
      "type": "object"
    },
    "DataFusionConfig": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "default": 8192,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "target_partitions": {
          "default": 1,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "DataSourceSpec": {
      "additionalProperties": false,
      "properties": {
        "data": true,
        "format": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "input": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "input",
        "format",
        "data"
      ],
      "type": "object"
    },
    "DeliveryRequest": {
      "description": "Requested delivery guarantee for one project output.",
      "enum": [
        "best_effort",
        "at_least_once",
        "exactly_once"
      ],
      "type": "string"
    },
    "EdgeSpec": {
      "additionalProperties": false,
      "properties": {
        "source_node": {
          "type": "string"
        },
        "source_port": {
          "default": "output",
          "type": "string"
        },
        "target_node": {
          "type": "string"
        },
        "target_port": {
          "default": "input",
          "type": "string"
        }
      },
      "required": [
        "source_node",
        "target_node"
      ],
      "type": "object"
    },
    "FormatRef": {
      "additionalProperties": false,
      "description": "Exact identity of a registered format codec.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "NodeSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "input_ports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PortSpec"
          },
          "type": "array"
        },
        "operator": {
          "$ref": "#/$defs/OperatorSpec"
        },
        "output_ports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PortSpec"
          },
          "type": "array"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "operator"
      ],
      "type": "object"
    },
    "OperatorSpec": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "expression": {
              "default": "",
              "type": "string"
            },
            "filter": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "expression",
              "type": "string"
            },
            "select": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "udfs": {
              "default": [],
              "items": {
                "$ref": "#/$defs/UdfReference"
              },
              "type": "array"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "aliases": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "sql",
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "udfs": {
              "default": [],
              "items": {
                "$ref": "#/$defs/UdfReference"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "query",
            "aliases"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Same-schema multi-input forwarding for stream graphs.",
          "properties": {
            "kind": {
              "const": "union",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Stateful event-time aggregation for stream graphs.",
          "properties": {
            "kind": {
              "const": "window",
              "type": "string"
            },
            "spec": {
              "$ref": "#/$defs/WindowSpec"
            }
          },
          "required": [
            "kind",
            "spec"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "external",
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "options": {
              "additionalProperties": true,
              "default": {},
              "type": "object"
            },
            "provider": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider",
            "name",
            "version"
          ],
          "type": "object"
        }
      ]
    },
    "PipelineSpec": {
      "additionalProperties": false,
      "properties": {
        "datafusion": {
          "$ref": "#/$defs/DataFusionConfig",
          "default": {
            "batch_size": 8192,
            "target_partitions": 1
          }
        },
        "edges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EdgeSpec"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/NodeSpec"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "nodes"
      ],
      "type": "object"
    },
    "PortSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/BatchKind"
        },
        "name": {
          "type": "string"
        },
        "required": {
          "default": true,
          "type": "boolean"
        },
        "schema": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArrowFieldSpec"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "type": "object"
    },
    "PositionSpec": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "ProjectSinkBinding": {
      "additionalProperties": false,
      "description": "A data-only sink binding to one registered connector.",
      "properties": {
        "binding": {
          "description": "External graph output this binding drains.",
          "type": "string"
        },
        "connector": {
          "$ref": "#/$defs/ConnectorRef",
          "description": "Exact registered connector identity."
        },
        "delivery": {
          "$ref": "#/$defs/DeliveryRequest",
          "description": "Requested delivery guarantee for this output."
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormatRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional exact wire-format identity."
        },
        "options": {
          "additionalProperties": true,
          "default": {},
          "description": "Bounded non-secret connector options.",
          "type": "object"
        },
        "secrets": {
          "additionalProperties": {
            "$ref": "#/$defs/SecretReference"
          },
          "default": {},
          "description": "Named secret references resolved only when the connector opens.",
          "type": "object"
        }
      },
      "required": [
        "binding",
        "connector",
        "delivery"
      ],
      "type": "object"
    },
    "ProjectSourceBinding": {
      "additionalProperties": false,
      "description": "A data-only source binding to one registered connector.",
      "properties": {
        "binding": {
          "description": "External graph input this binding feeds.",
          "type": "string"
        },
        "connector": {
          "$ref": "#/$defs/ConnectorRef",
          "description": "Exact registered connector identity."
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormatRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional exact wire-format identity."
        },
        "options": {
          "additionalProperties": true,
          "default": {},
          "description": "Bounded non-secret connector options.",
          "type": "object"
        },
        "schema": {
          "default": [],
          "description": "Optional exact Arrow schema.",
          "items": {
            "$ref": "#/$defs/ArrowFieldSpec"
          },
          "type": "array"
        },
        "secrets": {
          "additionalProperties": {
            "$ref": "#/$defs/SecretReference"
          },
          "default": {},
          "description": "Named secret references resolved only when the connector opens.",
          "type": "object"
        },
        "watermark": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectWatermarkPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional event-time watermark policy."
        }
      },
      "required": [
        "binding",
        "connector"
      ],
      "type": "object"
    },
    "ProjectWatermarkPolicy": {
      "description": "Event-time policy carried by one project source binding.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "policy": {
              "const": "source_provided",
              "type": "string"
            }
          },
          "required": [
            "policy"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string"
            },
            "delay_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "emit_interval_ms": {
              "default": 0,
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "idle_timeout_ms": {
              "default": null,
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "policy": {
              "const": "bounded_out_of_orderness",
              "type": "string"
            }
          },
          "required": [
            "policy",
            "column",
            "delay_ms"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "policy": {
              "const": "disabled",
              "type": "string"
            }
          },
          "required": [
            "policy"
          ],
          "type": "object"
        }
      ]
    },
    "RunOptions": {
      "additionalProperties": false,
      "properties": {
        "max_input_bytes": {
          "default": 10485760,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_rows": {
          "default": 100000,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "memory_limit_mb": {
          "default": 512,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "output_rows": {
          "default": 1000,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 30,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "RuntimeSpec": {
      "description": "Runtime mode and mode-specific limits for a project-v3 document.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A bounded batch run using inline data fixtures.",
          "properties": {
            "mode": {
              "const": "batch",
              "type": "string"
            },
            "options": {
              "$ref": "#/$defs/RunOptions"
            }
          },
          "required": [
            "mode",
            "options"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A continuous run using registered connector bindings.",
          "properties": {
            "mode": {
              "const": "stream",
              "type": "string"
            },
            "options": {
              "$ref": "#/$defs/StreamRunOptions"
            }
          },
          "required": [
            "mode",
            "options"
          ],
          "type": "object"
        }
      ]
    },
    "SecretReference": {
      "additionalProperties": false,
      "description": "A named pointer to a secret; the only secret-shaped value a data-only\ndocument may carry.",
      "properties": {
        "key": {
          "description": "Resolver-specific key, for example the variable name.",
          "type": "string"
        },
        "resolver": {
          "$ref": "#/$defs/SecretResolverKind",
          "description": "Resolution source."
        }
      },
      "required": [
        "resolver",
        "key"
      ],
      "type": "object"
    },
    "SecretResolverKind": {
      "description": "Where a secret reference is resolved from.",
      "oneOf": [
        {
          "const": "environment",
          "description": "Resolved from a process environment variable.",
          "type": "string"
        },
        {
          "const": "file",
          "description": "Resolved from a file path.",
          "type": "string"
        },
        {
          "const": "registered",
          "description": "Resolved from a trusted in-process registry.",
          "type": "string"
        }
      ]
    },
    "StateConfig": {
      "additionalProperties": false,
      "description": "Managed state location and checkpoint retention for stream projects.",
      "properties": {
        "retention": {
          "default": 3,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "root": {
          "default": ".calc-flow-state",
          "type": "string"
        }
      },
      "type": "object"
    },
    "StreamRunOptions": {
      "additionalProperties": false,
      "description": "Continuous runtime limits carried by project v3.",
      "properties": {
        "checkpoint_interval_ms": {
          "default": 30000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_batch_bytes": {
          "default": 67108864,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_batch_rows": {
          "default": 10000,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "UdfKind": {
      "enum": [
        "data_fusion_scalar",
        "external_scalar",
        "external_array"
      ],
      "type": "string"
    },
    "UdfReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/UdfKind"
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "name",
        "version",
        "kind"
      ],
      "type": "object"
    },
    "WindowGeometry": {
      "description": "Fixed UTC window geometry represented in exact microseconds.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Non-overlapping windows of one fixed size.",
          "properties": {
            "kind": {
              "const": "tumbling",
              "type": "string"
            },
            "size_micros": {
              "description": "Window size in exact microseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "size_micros"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Fixed-size windows beginning at every slide coordinate.",
          "properties": {
            "kind": {
              "const": "hopping",
              "type": "string"
            },
            "size_micros": {
              "description": "Window size in exact microseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "slide_micros": {
              "description": "Window slide in exact microseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "size_micros",
            "slide_micros"
          ],
          "type": "object"
        }
      ]
    },
    "WindowSpec": {
      "additionalProperties": false,
      "description": "Data-only declaration of one event-time window aggregation.",
      "properties": {
        "aggregates": {
          "description": "Aggregates in semantic declaration order.",
          "items": {
            "$ref": "#/$defs/AggregateSpec"
          },
          "type": "array"
        },
        "event_time_column": {
          "description": "Input timestamp column used for window assignment.",
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/WindowGeometry",
          "description": "Fixed tumbling or hopping geometry."
        },
        "group_by": {
          "description": "Group columns in semantic declaration order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "event_time_column",
        "group_by",
        "geometry",
        "aggregates"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data_sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DataSourceSpec"
      },
      "type": "array"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "format_version": {
      "const": 3,
      "type": "integer"
    },
    "graph": {
      "$ref": "#/$defs/PipelineSpec"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeSpec"
    },
    "sinks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProjectSinkBinding"
      },
      "type": "array"
    },
    "sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProjectSourceBinding"
      },
      "type": "array"
    },
    "state": {
      "$ref": "#/$defs/StateConfig",
      "default": {
        "retention": 3,
        "root": ".calc-flow-state"
      }
    }
  },
  "required": [
    "format_version",
    "id",
    "name",
    "runtime",
    "graph"
  ],
  "title": "Calc Flow Project V3",
  "type": "object"
}