{
  "name": "calc-flow-web-ui",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "build:wheel": "npm run sync:api && npm run build && uv build --project backend --wheel --out-dir ../dist",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "sync:api": "UV_CACHE_DIR=/tmp/calc-flow-web-uv-cache uv run --project backend python scripts/export_openapi.py && npm run generate:api",
    "benchmark": "vitest bench --run"
  },
  "dependencies": {
    "@xyflow/react": "12.11.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
